# ===== rules_rag 大模型配置 =====
# 改完保存即可，重启服务生效（也可以调 POST /api/llm/test 热验证，不用重启）。
# 不填任何东西 = 用模板生成，服务照常可用。

# 总开关：auto/on 都可，off 表示强制走模板（想对比两条路径的效果时用）
LLM=auto

# ------------------------------------------------------------------
# 用法 A：选一个预设厂商，只填 key（推荐，最省事）
# 可选：deepseek / dashscope / moonshot / zhipu / openai / ollama
# ------------------------------------------------------------------
LLM_PROVIDER=

# 各家 key（填在对应那一行，其余留空）
# DeepSeek   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 通义千问   https://bailian.console.aliyun.com   （模型 qwen-plus / qwen-max / qwen-turbo）
DASHSCOPE_API_KEY=
# Kimi       https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=
# 智谱 GLM   https://open.bigmodel.cn/usercenter/apikeys   （glm-4-flash 免费）
ZHIPU_API_KEY=
# OpenAI     https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------
# 用法 B：任意 OpenAI 兼容服务，直接填三项（优先级高于预设）
# base_url 要到 /v1 这一层，不要带 /chat/completions
# ------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
# 不填则用预设厂商的默认模型
LLM_MODEL=

# 本地 Ollama（无需 key）：先 ollama serve，再 ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# ------------------------------------------------------------------
# 生成参数
# ------------------------------------------------------------------
# 单次调用超时（秒）。超时立即退回模板，不会让接口挂住
LLM_TIMEOUT=25
# 回答长度上限
LLM_MAX_TOKENS=600
# 合规问答要稳定，别让它发挥
LLM_TEMPERATURE=0.2
